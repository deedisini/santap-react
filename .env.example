VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_SQL_API_URL=http://127.0.0.1:8788

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=santap
MYSQL_USER=root
MYSQL_PASSWORD=
SQL_SERVER_PORT=8788

# Gmail SMTP server (used only by server/emailServer.js; never use VITE_ here)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=SANTAP Dining Hall

# Server only: ADC service-account JSON path outside the repository. Never VITE_.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
EMAIL_SERVER_PORT=8787
FEEDBACK_TO=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional browser push: public VAPID key from Firebase Console.
VITE_FIREBASE_VAPID_KEY=
# Server only. Firestore delivery claims deduplicate worker events.
ENABLE_PUSH_WORKER=false
