@startchen SANTAP_ERD

title ERD Konseptual SANTAP
left to right direction
skinparam nodesep 10
skinparam ranksep 15

entity "Akun" as ACCOUNT {
  id_akun <<key>>
  email
  nama
  peran
}

entity "Mahasiswa" as STUDENT {
  nim <<key>>
  nama
  fakultas
  status_asrama
}

entity "Periode Makan" as MEAL_PERIOD {
  id_periode <<key>>
  nama_periode
  jam_layanan
}

entity "Antrean" as QUEUE {
  id_antrean <<key>>
  status
  waktu_masuk
}

entity "Catatan Makan" as MEAL_RECORD {
  id_catatan <<key>>
  tanggal
  waktu
  token_verifikasi
}

relationship "Memiliki" as OWNS_ACCOUNT {
}
relationship "Masuk" as JOINS_QUEUE {
}
relationship "Untuk" as QUEUE_PERIOD {
}
relationship "Menerima" as HAS_RECORD {
}
relationship "Terjadi Pada" as RECORD_PERIOD {
}
relationship "Memverifikasi" as VERIFIES {
}

ACCOUNT -right-(0,1)- OWNS_ACCOUNT
OWNS_ACCOUNT -right-(0,1)- STUDENT

STUDENT -right-(0,N)- JOINS_QUEUE
JOINS_QUEUE -right-(1,1)- QUEUE

QUEUE -right-(1,1)- QUEUE_PERIOD
QUEUE_PERIOD -right-(0,N)- MEAL_PERIOD

STUDENT -right-(0,N)- HAS_RECORD
HAS_RECORD -right-(1,1)- MEAL_RECORD

MEAL_RECORD -right-(1,1)- RECORD_PERIOD
RECORD_PERIOD -right-(0,N)- MEAL_PERIOD

ACCOUNT -down-(0,N)- VERIFIES
VERIFIES -right-(1,1)- MEAL_RECORD

@endchen
