@startuml SANTAP_USE_CASE
left to right direction
skinparam packageStyle rectangle

actor Mahasiswa
actor Staff
actor Supervisor
actor Head
actor Admin

rectangle "SANTAP" {
  usecase "UC-01\nLogin" as UC01
  usecase "UC-02\nTampilkan QR Identitas" as UC02
  usecase "UC-03\nMasuk dan Lihat Antrean" as UC03
  usecase "UC-04\nProses Pengambilan Makanan" as UC04
  usecase "UC-05\nMonitor Operasional" as UC05
  usecase "UC-06\nKelola Profil Mahasiswa" as UC06
  usecase "Identifikasi Mahasiswa" as UCA
  usecase "Scan QR" as UCB
  usecase "Input NIM Manual" as UCC
  usecase "Validasi Periode dan Duplikasi" as UCD
  usecase "Simpan Catatan Pengambilan" as UCE
}

Mahasiswa --> UC01
Mahasiswa --> UC02
Mahasiswa --> UC03
Staff --> UC01
Staff --> UC04
Supervisor --> UC01
Supervisor --> UC05
Head --> UC01
Head --> UC05
Admin --> UC01
Admin --> UC06

UC04 .> UCA : <<include>>
UC04 .> UCD : <<include>>
UC04 .> UCE : <<include>>
UCB .> UCA : <<extend>>
UCC .> UCA : <<extend>>

note bottom of UCA
  Staff memilih QR atau NIM
  sebagai metode identifikasi.
end note
@enduml
