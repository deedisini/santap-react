rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleIs(role) { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role; }
    function staffOrAbove() { return roleIs('Staff') || roleIs('Supervisor') || roleIs('Head') || roleIs('Admin'); }
    function manager() { return roleIs('Supervisor') || roleIs('Head') || roleIs('Admin'); }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || staffOrAbove());
      // Trusted Admin SDK APIs alone manage identity and roles, preventing escalation.
      allow write: if false;
    }
    match /students/{nim} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /mealPeriods/{periodId} {
      allow read: if signedIn();
      allow update: if staffOrAbove();
      allow create, delete: if roleIs('Head') || roleIs('Admin');
    }
    match /queues/{queueId} {
      allow read: if signedIn();
      allow create: if staffOrAbove() || (roleIs('Mahasiswa') && request.resource.data.nim == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nim);
      allow update: if staffOrAbove();
      allow delete: if roleIs('Head') || roleIs('Admin');
    }
    match /mealRecords/{recordId} {
      allow read: if signedIn();
      allow create: if staffOrAbove();
      allow update, delete: if roleIs('Head') || roleIs('Admin');
    }
  }
}

